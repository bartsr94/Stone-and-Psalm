# Godot 4+
.godot/
/android/
*.translation

# Note: *.import files ARE committed in Godot 4 — they carry import settings and stable
# resource UIDs. Only the .godot/ cache is generated. (Godot 3 ignored them; this is 4.6.)

# Export config can carry keystore paths and passwords
export_presets.cfg

# Mono / C# — not used here, but harmless to keep ignored
.mono/
data_*/

# Builds
builds/
/build/
/export/
*.exe
*.pck

# Test output
test_results.txt
test_errors.txt

# Blender
*.blend1
*.blend2
__pycache__/

# Secrets — .mcp.json reads these from the environment, never inline
.env

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Tooling caches
.serena/

# scratch from tool runs
shot_out.txt
shot_err.txt
import_out.txt
import_err.txt

# Reference scenes (third-party, large). Never committed.
assets/reference/

# Terrain3D ships a sample project; it landed at the repo root with the addon install. Not the game.
/demo/

# Windows replace-file leftovers, e.g. the Godot editor swapping a GDExtension dll it has loaded
*.TMP
